{
  "name": "leyanimal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Obligaciones legales de tu animal de compania en Espana",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "pnpm format:check && pnpm datos:comprobar && pnpm lint && pnpm typecheck && pnpm test",
    "datos:comprobar": "node scripts/contenido/comprobar.mjs",
    "datos:geografia": "node scripts/contenido/generar-geografia.mjs",
    "datos:autonomicas": "node scripts/contenido/generar-autonomicas.mjs",
    "datos:referencia": "node scripts/contenido/generar-referencia-estatal.mjs",
    "datos:extraer": "node scripts/contenido/extraer-autonomicas.mjs",
    "og": "node scripts/generar-og.mjs",
    "iconos": "node scripts/generar-ilustraciones.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "astro": "7.3.5",
    "lucide-preact": "1.48.0",
    "preact": "10.29.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^4.1.11"
  }
}
