---
/**
 * Referencia visible (norma y articulo) que se despliega en la cita literal.
 * Para listas con muchas afirmaciones, donde todas las citas abiertas a la
 * vez harian la pagina ilegible.
 */
import { ChevronDown } from 'lucide-preact';
import { traductor } from '@/i18n/catalogos';
import type { Idioma } from '@/i18n/idiomas';
import { articulo, norma } from '@/lib/datos';
import { nombreNorma } from '@/lib/datos/textos';
import { CitaLegal } from '@/ui/CitaLegal';

interface Props {
  idioma: Idioma;
  ids: readonly string[];
}

const { idioma, ids } = Astro.props;
const t = traductor(idioma);
const fuentes = ids.flatMap((id) => {
  const a = articulo(id);
  const n = a ? norma(a.norma) : undefined;
  return a && n ? [{ a, n }] : [];
});
---

{fuentes.length > 0 ? (
  <details class="group">
    <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 text-sm font-medium text-marca-700 [&::-webkit-details-marker]:hidden">
      <ChevronDown
        class="size-4 transition-transform group-open:rotate-180"
        aria-hidden="true"
      />
      {fuentes
        .map(({ a, n }) => `${nombreNorma(n)}, ${a.referencia}`)
        .join(' · ')}
      <span class="sr-only">— {t('ley.citaLiteral')}</span>
    </summary>
    <div class="mt-2 grid gap-3">
      {fuentes.map(({ a, n }) => (
        <CitaLegal norma={n} articulo={a} t={t} />
      ))}
    </div>
  </details>
) : null}
