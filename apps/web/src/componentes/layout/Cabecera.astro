---
/**
 * Cabecera fija. Transparente sobre la banda menta de cada pagina y con fondo
 * de cristal en cuanto se hace scroll (lo activa scripts/efectos.ts).
 */
import { ArrowRight } from 'lucide-preact';
import Logo from '@/componentes/marca/Logo.astro';
import { textosPara, traductor } from '@/i18n/catalogos';
import { ruta, type Idioma } from '@/i18n/idiomas';
import Buscador from '@/islas/Buscador';
import { MENU } from '@/lib/sitio';
import MenuMovil from './MenuMovil.astro';

interface Props {
  idioma: Idioma;
  /** Ruta de la pagina sin prefijo de idioma, para marcar la actual. */
  rutaActual: string;
}

const { idioma, rutaActual } = Astro.props;
const t = traductor(idioma, 'navegacion');
const otro: Idioma = idioma === 'es' ? 'en' : 'es';
const esActual = (href: string) =>
  rutaActual === href || rutaActual.startsWith(`${href}/`);
---

<header class="cabecera">
  <div class="contenedor flex h-[var(--cabecera)] items-center gap-4 lg:gap-8">
    <a
      href={ruta('/', idioma)}
      class="relative z-[56] flex shrink-0 items-center rounded-md"
      aria-label={t('inicio')}
    >
      <Logo />
    </a>

    <nav class="hidden lg:block" aria-label={t('principal')}>
      <ul class="flex items-center gap-1">
        {MENU.map(({ href, clave }) => (
          <li>
            <a
              href={ruta(href, idioma)}
              class="nav-enlace"
              aria-current={esActual(href) ? 'page' : undefined}
            >
              {t(clave)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <Buscador
        client:idle
        idioma={idioma}
        textos={textosPara(idioma, ['buscador'])}
      />
      <a
        href={ruta(rutaActual, otro)}
        hreflang={otro}
        lang={otro}
        data-cambio-idioma
        class="hidden h-11 items-center rounded-full px-3 text-[0.8125rem] font-semibold text-texto-2 uppercase transition-colors hover:bg-marca-50 hover:text-marca-700 sm:inline-flex"
        aria-label={t('cambiarIdioma')}
      >
        <span aria-hidden="true">{otro}</span>
      </a>
      <a
        href={ruta('/consulta', idioma)}
        class="boton boton--principal boton--sm hidden md:inline-flex"
      >
        {t('consultar')}
        <ArrowRight aria-hidden="true" />
      </a>
      <MenuMovil idioma={idioma} rutaActual={rutaActual} />
    </div>
  </div>
</header>
