---
/**
 * Menu movil a pantalla completa: enlaces grandes que entran escalonados.
 * Cerrado es `inert`, para que el teclado y los lectores de pantalla no lo
 * recorran; Escape lo cierra y devuelve el foco al boton.
 */
import { ArrowRight } from 'lucide-preact';
import { traductor } from '@/i18n/catalogos';
import { ruta, type Idioma } from '@/i18n/idiomas';
import { MENU } from '@/lib/sitio';

interface Props {
  idioma: Idioma;
  rutaActual: string;
}

const { idioma, rutaActual } = Astro.props;
const t = traductor(idioma, 'navegacion');
const otro: Idioma = idioma === 'es' ? 'en' : 'es';
---

<button
  type="button"
  class="boton-menu lg:hidden"
  aria-expanded="false"
  aria-controls="menu-movil"
  aria-label={t('abrirMenu')}
  data-abrir={t('abrirMenu')}
  data-cerrar={t('cerrarMenu')}
>
  <span></span>
  <span></span>
</button>

<div id="menu-movil" class="menu-movil lg:hidden" inert>
  <nav aria-label={t('principal')}>
    {MENU.map(({ href, clave }, i) => (
      <a
        href={ruta(href, idioma)}
        class="menu-movil__enlace"
        style={`--i: ${i}`}
      >
        {t(clave)}
        <ArrowRight aria-hidden="true" />
      </a>
    ))}
  </nav>
  <div class="mt-auto grid gap-4 pt-8">
    <a href={ruta('/consulta', idioma)} class="boton boton--principal w-full">
      {t('empezarConsulta')}
      <ArrowRight aria-hidden="true" />
    </a>
    <a
      href={ruta(rutaActual, otro)}
      hreflang={otro}
      lang={otro}
      data-cambio-idioma
      class="boton boton--contorno w-full"
    >
      {t('cambiarIdioma')}
    </a>
    <p class="text-sm text-texto-3">{t('descargoCorto')}</p>
  </div>
</div>

<script>
  const boton = document.querySelector<HTMLButtonElement>('.boton-menu');
  const menu = document.getElementById('menu-movil');

  function poner(abierto: boolean) {
    if (!boton || !menu) return;
    boton.setAttribute('aria-expanded', String(abierto));
    boton.setAttribute(
      'aria-label',
      (abierto ? boton.dataset.cerrar : boton.dataset.abrir) ?? '',
    );
    menu.classList.toggle('abierto', abierto);
    menu.inert = !abierto;
    document.body.classList.toggle('menu-abierto', abierto);
  }

  boton?.addEventListener('click', () =>
    poner(boton.getAttribute('aria-expanded') !== 'true'),
  );
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) poner(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && boton?.getAttribute('aria-expanded') === 'true') {
      poner(false);
      boton.focus();
    }
  });
</script>
