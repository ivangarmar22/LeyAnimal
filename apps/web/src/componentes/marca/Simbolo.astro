---
/**
 * Simbolo de LeyAnimal. "partido" es el del logotipo; "macizo" se lee mejor
 * a tamanos muy pequenos. El color sale de `currentColor` y la huella en
 * negativo del color de fondo del tema.
 */
import {
  ALMOHADILLA,
  ALMOHADILLA_DERECHA,
  ALMOHADILLA_IZQUIERDA,
  DEDOS,
  ESCUDO,
  ESCUDO_IZQUIERDO,
  ESCUDO_MACIZO,
} from './formas';

interface Props {
  class?: string;
  variante?: 'partido' | 'macizo';
}

const { class: clase, variante = 'partido' } = Astro.props;
const girar = (cx: number, cy: number, giro: number) =>
  `rotate(${giro} ${cx} ${cy})`;
---

<svg viewBox="0 0 48 52" class={clase} aria-hidden="true" focusable="false">
  {variante === 'partido' ? (
    <>
      <path
        d={ESCUDO}
        fill="none"
        stroke="currentColor"
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path d={ESCUDO_IZQUIERDO} fill="currentColor" />
      <g fill="var(--color-fondo, #fff)">
        <path d={ALMOHADILLA_IZQUIERDA} />
        {DEDOS.slice(0, 2).map(([cx, cy, rx, ry, g]) => (
          <ellipse
            cx={cx}
            cy={cy}
            rx={rx}
            ry={ry}
            transform={girar(cx, cy, g)}
          />
        ))}
      </g>
      <g fill="currentColor">
        <path d={ALMOHADILLA_DERECHA} />
        {DEDOS.slice(2).map(([cx, cy, rx, ry, g]) => (
          <ellipse
            cx={cx}
            cy={cy}
            rx={rx}
            ry={ry}
            transform={girar(cx, cy, g)}
          />
        ))}
      </g>
    </>
  ) : (
    <>
      <path d={ESCUDO_MACIZO} fill="currentColor" />
      <g fill="var(--color-fondo, #fff)">
        <path d={ALMOHADILLA} />
        {DEDOS.map(([cx, cy, rx, ry, g]) => (
          <ellipse
            cx={cx}
            cy={cy}
            rx={rx}
            ry={ry}
            transform={girar(cx, cy, g)}
          />
        ))}
      </g>
    </>
  )}
</svg>
