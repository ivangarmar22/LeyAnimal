---
/**
 * Migas de pan con su BreadcrumbList. El inicio se anade siempre y el ultimo
 * elemento es la pagina actual, sin enlace.
 */
import JsonLd from '@/componentes/seo/JsonLd.astro';
import { traductor } from '@/i18n/catalogos';
import { ruta, type Idioma } from '@/i18n/idiomas';
import { urlAbsoluta } from '@/lib/seo';

export type Miga = { nombre: string; href?: string };

interface Props {
  idioma: Idioma;
  items: Miga[];
  actual: string;
}

const { idioma, items, actual } = Astro.props;
const t = traductor(idioma, 'comun');
const lista: Miga[] = [{ nombre: t('inicio'), href: '/' }, ...items];
---

<nav class="migas" aria-label={t('migas')}>
  <ol>
    {lista.map((m) => (
      <li>
        {m.href ? (
          <a href={ruta(m.href, idioma)}>{m.nombre}</a>
        ) : (
          <span>{m.nombre}</span>
        )}
      </li>
    ))}
    <li>
      <span aria-current="page">{actual}</span>
    </li>
  </ol>
  <JsonLd
    datos={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [...lista, { nombre: actual }].map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.nombre,
        ...(m.href ? { item: urlAbsoluta(m.href, idioma) } : {}),
      })),
    }}
  />
</nav>
