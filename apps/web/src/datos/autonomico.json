 "articulos": [
  {
   "id": "ley-animales-andalucia#Artículo 17",
   "norma": "ley-animales-andalucia",
   "referencia": "Artículo 17",
   "epigrafe": null,
   "textoLiteral": "Los perros y gatos, así como otros animales que reglamentariamente se determinen, deberán ser identificados individualmente mediante sistema de identificación electrónica normalizado, implantado por veterinario, dentro del plazo máximo de tres meses desde su nacimiento.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2003-23292#a1-9"
  },
  {
   "id": "ley-animales-aragon#Artículo 15",
   "norma": "ley-animales-aragon",
   "referencia": "Artículo 15",
   "epigrafe": null,
   "textoLiteral": "Los poseedores de perros que lo sean por cualquier título, y, en su caso, sus propietarios, deberán censarlos en el Ayuntamiento del municipio donde residan habitualmente los animales, dentro de un plazo máximo de tres meses a partir de la fecha de la adquisición de su propiedad o posesión.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2003-8225#a1-7"
  },
  {
   "id": "ley-animales-castilla-la-mancha#Artículo 14",
   "norma": "ley-animales-castilla-la-mancha",
   "referencia": "Artículo 14",
   "epigrafe": null,
   "textoLiteral": "Los perros, gatos y hurones deberán ser identificados individualmente mediante sistemas normalizados, implantados por personal veterinario.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2020-13916#a1-6"
  },
  {
   "id": "ley-animales-castilla-la-mancha#Artículo 4",
   "norma": "ley-animales-castilla-la-mancha",
   "referencia": "Artículo 4",
   "epigrafe": null,
   "textoLiteral": "a) Identificar al animal e inscribirle en los registros y censos que en cada caso correspondan, según lo dispuesto en la normativa vigente.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2020-13916#a4"
  },
  {
   "id": "ley-animales-cataluna#Artículo 14",
   "norma": "ley-animales-cataluna",
   "referencia": "Artículo 14",
   "epigrafe": null,
   "textoLiteral": "Los ayuntamientos deben llevar un censo municipal de animales de compañía en el que se deben inscribir los perros, los gatos y los hurones que residen de manera habitual en el municipio.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=DOGC-f-2008-90016#a14"
  },
  {
   "id": "ley-animales-cataluna#Artículo 15",
   "norma": "ley-animales-cataluna",
   "referencia": "Artículo 15",
   "epigrafe": null,
   "textoLiteral": "Los perros, los gatos y los hurones deben ser identificados mediante: a) Una identificación electrónica con la implantación de un microchip homologado.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=DOGC-f-2008-90016#a15"
  },
  {
   "id": "ley-animales-comunidad-de-madrid#Artículo 11",
   "norma": "ley-animales-comunidad-de-madrid",
   "referencia": "Artículo 11",
   "epigrafe": null,
   "textoLiteral": "Serán obligatoriamente objeto de identificación, mediante microchip, los perros, gatos, hurones, conejos y équidos.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2016-11097#a1-3"
  },
  {
   "id": "ley-animales-comunidad-de-madrid#Artículo 6",
   "norma": "ley-animales-comunidad-de-madrid",
   "referencia": "Artículo 6",
   "epigrafe": null,
   "textoLiteral": "a) Contratar un seguro de responsabilidad civil en aquellos casos que se determine reglamentariamente.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2016-11097#a6"
  },
  {
   "id": "ley-animales-comunidad-foral-de-navarra#Artículo 8",
   "norma": "ley-animales-comunidad-foral-de-navarra",
   "referencia": "Artículo 8",
   "epigrafe": null,
   "textoLiteral": "Es obligatoria la identificación de perros, gatos y hurones mediante microchip homologado, portador de un código único validado por el Registro de Identificación de Animales de Compañía de Navarra.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2019-6779#ar-8"
  },
  {
   "id": "ley-animales-comunitat-valenciana#Artículo 10",
   "norma": "ley-animales-comunitat-valenciana",
   "referencia": "Artículo 10",
   "epigrafe": null,
   "textoLiteral": "Están obligatoriamente sujetos a identificación los animales de la especie canina, felina, mustélidos domésticos, los animales que habiten en santuarios que no estén sujetos a identificación individual y las especies de animales que se determine reglamentariamente.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2023-7421#a1-2"
  },
  {
   "id": "ley-animales-galicia#Artículo 12",
   "norma": "ley-animales-galicia",
   "referencia": "Artículo 12",
   "epigrafe": null,
   "textoLiteral": "A efectos de la presente ley, la identificación de los animales de la especie canina es obligatoria sin excepción. El animal deberá ser identificado dentro de los tres primeros meses de vida y, en todo caso, antes de ser objeto de transmisión.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2017-12357#a1-4"
  },
  {
   "id": "ley-animales-pais-vasco#Artículo 4",
   "norma": "ley-animales-pais-vasco",
   "referencia": "Artículo 4",
   "epigrafe": null,
   "textoLiteral": "m) Contratar un seguro de responsabilidad civil para la tenencia de perros, y para aquellas especies que se determine reglamentariamente.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2022-14086#a4"
  },
  {
   "id": "ley-animales-principado-de-asturias#Artículo 12",
   "norma": "ley-animales-principado-de-asturias",
   "referencia": "Artículo 12",
   "epigrafe": null,
   "textoLiteral": "Los perros y gatos deberán ser identificados individualmente mediante la implantación de un microchip en las condiciones que reglamentariamente se determinen y, en todo caso, deberán estar identificados antes de su venta o cesión.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2003-2102#a12"
  },
  {
   "id": "ley-animales-region-de-murcia#Artículo 4",
   "norma": "ley-animales-region-de-murcia",
   "referencia": "Artículo 4",
   "epigrafe": null,
   "textoLiteral": "f) Contratar un seguro de responsabilidad civil en aquellos casos que se determine reglamentariamente.",
   "urlAncla": "https://www.boe.es/buscar/act.php?id=BOE-A-2017-15288#a4"
  }
 ],
