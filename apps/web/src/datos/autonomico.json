 "fuentes": [
  {
   "regla": "0641369e-e62b-b78f-fcd2-ab07b2259d11",
   "articulo": "ley-animales-comunidad-de-madrid#Artículo 11",
   "cita": "Serán obligatoriamente objeto de identificación, mediante microchip, los perros, gatos, hurones, conejos y équidos."
  },
  {
   "regla": "09c95faf-ca12-7712-e474-f8756f22a197",
   "articulo": "ley-animales-cataluna#Artículo 14",
   "cita": "Los ayuntamientos deben llevar un censo municipal de animales de compañía en el que se deben inscribir los perros, los gatos y los hurones que residen de manera habitual en el municipio."
  },
  {
   "regla": "1f005d4f-c5a9-bfe0-37bb-01ccc1a6f71a",
   "articulo": "ley-animales-cataluna#Artículo 15",
   "cita": "Los perros, los gatos y los hurones deben ser identificados mediante: a) Una identificación electrónica con la implantación de un microchip homologado."
  },
  {
   "regla": "4648206b-02df-8d2a-7eb7-072894b589bc",
   "articulo": "ley-animales-principado-de-asturias#Artículo 12",
   "cita": "Los perros y gatos deberán ser identificados individualmente mediante la implantación de un microchip en las condiciones que reglamentariamente se determinen y, en todo caso, deberán estar identificados antes de su venta o cesión."
  },
  {
   "regla": "5d3bb43e-6771-9b84-9fff-d41d1a112a48",
   "articulo": "ley-animales-castilla-la-mancha#Artículo 4",
   "cita": "a) Identificar al animal e inscribirle en los registros y censos que en cada caso correspondan, según lo dispuesto en la normativa vigente."
  },
  {
   "regla": "6ca96957-b010-75c9-a497-9d522038f96d",
   "articulo": "ley-animales-comunitat-valenciana#Artículo 10",
   "cita": "Están obligatoriamente sujetos a identificación los animales de la especie canina, felina, mustélidos domésticos, los animales que habiten en santuarios que no estén sujetos a identificación individual y las especies de animales que se determine reglamentariamente."
  },
  {
   "regla": "75a5face-0209-281b-4b5b-9212b8a27b3d",
   "articulo": "ley-animales-region-de-murcia#Artículo 4",
   "cita": "f) Contratar un seguro de responsabilidad civil en aquellos casos que se determine reglamentariamente."
  },
  {
   "regla": "80069e67-a97b-c481-e43b-e67fd7566edf",
   "articulo": "ley-animales-castilla-la-mancha#Artículo 14",
   "cita": "Los perros, gatos y hurones deberán ser identificados individualmente mediante sistemas normalizados, implantados por personal veterinario."
  },
  {
   "regla": "952e1b48-9010-f78a-3747-728c5920d38c",
   "articulo": "ley-animales-aragon#Artículo 15",
   "cita": "Los poseedores de perros que lo sean por cualquier título, y, en su caso, sus propietarios, deberán censarlos en el Ayuntamiento del municipio donde residan habitualmente los animales, dentro de un plazo máximo de tres meses a partir de la fecha de la adquisición de su propiedad o posesión."
  },
  {
   "regla": "c4383c09-b6fa-3024-a0d1-868b157c6747",
   "articulo": "ley-animales-andalucia#Artículo 17",
   "cita": "Los perros y gatos, así como otros animales que reglamentariamente se determinen, deberán ser identificados individualmente mediante sistema de identificación electrónica normalizado, implantado por veterinario, dentro del plazo máximo de tres meses desde su nacimiento."
  },
  {
   "regla": "c76be30c-66ff-fe3d-30ed-88c2e1919c48",
   "articulo": "ley-animales-galicia#Artículo 12",
   "cita": "A efectos de la presente ley, la identificación de los animales de la especie canina es obligatoria sin excepción. El animal deberá ser identificado dentro de los tres primeros meses de vida y, en todo caso, antes de ser objeto de transmisión."
  },
  {
   "regla": "c8a3c4a9-4659-8a62-debc-67a4fd880c5d",
   "articulo": "ley-animales-comunidad-foral-de-navarra#Artículo 8",
   "cita": "Es obligatoria la identificación de perros, gatos y hurones mediante microchip homologado, portador de un código único validado por el Registro de Identificación de Animales de Compañía de Navarra."
  },
  {
   "regla": "ed3d781e-d0d2-b939-b641-0fa7b47091a6",
   "articulo": "ley-animales-comunidad-de-madrid#Artículo 6",
   "cita": "a) Contratar un seguro de responsabilidad civil en aquellos casos que se determine reglamentariamente."
  },
  {
   "regla": "ff4dac09-5c8f-7c43-8fc3-5c1ca8650a7f",
   "articulo": "ley-animales-pais-vasco#Artículo 4",
   "cita": "m) Contratar un seguro de responsabilidad civil para la tenencia de perros, y para aquellas especies que se determine reglamentariamente."
  }
