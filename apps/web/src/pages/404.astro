---
/**
 * 404 unico (los alojamientos estaticos sirven un solo 404.html). Esta en
 * espanol, con acceso directo a la version inglesa.
 */
import { Picture } from 'astro:assets';
import { ArrowRight, Home } from 'lucide-preact';
import { traductor } from '@/i18n/catalogos';
import Base from '@/layouts/Base.astro';
import { FOTOS } from '@/lib/contenido/fotos';

const t = traductor('es', 'noEncontrado');
const te = traductor('en', 'noEncontrado');
const tc = traductor('es', 'comun');
---

<Base
  idioma="es"
  ruta="/404"
  titulo={t('titulo')}
  descripcion={t('texto')}
  indexable={false}
>
  <section class="cabecera-pagina tinte min-h-[80vh]">
    <div class="fondo-rejilla" aria-hidden="true"></div>
    <div class="fondo-brillo" aria-hidden="true"></div>
    <div class="contenedor grid items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
      <div>
        <p class="eyebrow">{t('eyebrow')}</p>
        <h1 class="titulo-pagina mt-5">{t('titulo')}</h1>
        <p class="entradilla mt-6">{t('texto')}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/consulta" class="boton boton--principal">
            {tc('empezarConsulta')}
            <ArrowRight aria-hidden="true" />
          </a>
          <a href="/" class="boton boton--contorno">
            <Home aria-hidden="true" />
            {t('irInicio')}
          </a>
        </div>
        <p class="mt-8 text-sm text-texto-3" lang="en">
          {te('titulo')}.{' '}
          <a href="/en" class="enlace-texto">
            {te('irInicio')}
          </a>
        </p>
      </div>
      <div class="hidden overflow-hidden rounded-[28px] border border-borde shadow-alta lg:block">
        <Picture
          src={FOTOS.perroSofa.imagen}
          formats={['avif', 'webp']}
          alt=""
          widths={[480, 720]}
          sizes="480px"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
    </div>
  </section>
</Base>
