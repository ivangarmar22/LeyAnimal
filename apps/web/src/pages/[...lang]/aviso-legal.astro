---
import PaginaTexto from '@/componentes/pagina/PaginaTexto.astro';
import { traductor } from '@/i18n/catalogos';
import { idiomaDe, rutasIdioma } from '@/i18n/idiomas';
import Base from '@/layouts/Base.astro';
import { EMAIL_CONTACTO, TITULAR } from '@/lib/sitio';

export const getStaticPaths = rutasIdioma;
const idioma = idiomaDe(Astro.params.lang);
const t = traductor(idioma, 'avisoLegal');
const tl = traductor(idioma, 'legal');
const etiquetas = t.raw('titularLista') as string[];
const valores = [
  TITULAR.nombre,
  TITULAR.nif,
  TITULAR.domicilio,
  EMAIL_CONTACTO,
];
const pendiente = valores.slice(0, 3).some((v) => !v);
---

<Base
  idioma={idioma}
  ruta="/aviso-legal"
  titulo={t('metaTitulo')}
  descripcion={t('metaDescripcion')}
>
  <PaginaTexto
    idioma={idioma}
    eyebrow={t('eyebrow')}
    titulo={t('titulo')}
    pendiente={pendiente}
  >
    <h2>{t('titular')}</h2>
    <dl class="grid gap-3">
      {etiquetas.map((etiqueta, i) => (
        <div class="grid gap-1 sm:grid-cols-[14rem_minmax(0,1fr)]">
          <dt class="font-medium text-texto">{etiqueta}</dt>
          <dd>
            {valores[i] ?? (
              <span class="text-texto-3 italic">{tl('pendiente')}</span>
            )}
          </dd>
        </div>
      ))}
    </dl>
    <h2>{t('objeto')}</h2>
    <p>{t('objetoTexto')}</p>
    <h2>{t('responsabilidad')}</h2>
    <p>{t('responsabilidadTexto')}</p>
    <h2>{t('enlaces')}</h2>
    <p>{t('enlacesTexto')}</p>
    <h2>{t('propiedad')}</h2>
    <p>{t('propiedadTexto')}</p>
    <h2>{t('ley')}</h2>
    <p>{t('leyTexto')}</p>
  </PaginaTexto>
</Base>
