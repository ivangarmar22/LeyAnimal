---
import { Picture } from 'astro:assets';
import {
  Accessibility,
  Camera,
  HeartHandshake,
  Quote,
  ShieldCheck,
} from 'lucide-preact';
import CabeceraPagina from '@/componentes/pagina/CabeceraPagina.astro';
import PanelCta from '@/componentes/pagina/PanelCta.astro';
import { traductor } from '@/i18n/catalogos';
import { idiomaDe, rutasIdioma } from '@/i18n/idiomas';
import Base from '@/layouts/Base.astro';
import { FOTOS } from '@/lib/contenido/fotos';

export const getStaticPaths = rutasIdioma;
const idioma = idiomaDe(Astro.params.lang);
const t = traductor(idioma, 'sobre');
const tcta = traductor(idioma, 'inicio.cta');
const foto = FOTOS.paseoCorrea;
const principios = [
  ['p1', ShieldCheck],
  ['p2', Quote],
  ['p3', HeartHandshake],
  ['p4', Accessibility],
] as const;
---

<Base
  idioma={idioma}
  ruta="/sobre"
  titulo={t('metaTitulo')}
  descripcion={t('metaDescripcion')}
>
  <CabeceraPagina
    idioma={idioma}
    eyebrow={t('eyebrow')}
    titulo={t('titulo')}
    entradilla={t('entradilla')}
    solape
  />

  <div class="contenedor solape pb-[var(--seccion)]">
    <div class="grid items-start gap-12 rounded-[28px] border border-borde bg-superficie p-5 shadow-alta sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-16 lg:p-12">
      <div class="prosa">
        <h2 class="!mt-0">{t('problema')}</h2>
        <p>{t('problemaTexto')}</p>
        <h2>{t('datos')}</h2>
        <p>{t('datosTexto')}</p>
        <ul>
          <li>
            <a
              href="https://www.boe.es/datosabiertos/"
              target="_blank"
              rel="noreferrer noopener"
            >
              BOE · Datos abiertos
            </a>
          </li>
          <li>
            <a
              href="https://www.ine.es/daco/daco42/codmun/"
              target="_blank"
              rel="noreferrer noopener"
            >
              INE · Relación de municipios
            </a>
          </li>
        </ul>
      </div>
      <figure class="marco-foto" data-aparece="recorte">
        <div class="overflow-hidden rounded-3xl">
          <Picture
            src={foto.imagen}
            formats={['avif', 'webp']}
            alt=""
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 480px, 100vw"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <figcaption class="mt-3 text-sm text-texto-3">
          <a
            href={foto.url}
            target="_blank"
            rel="noreferrer noopener"
            class="underline underline-offset-2"
          >
            {t('foto', { autor: foto.autor })}
          </a>
        </figcaption>
      </figure>
    </div>

    <section class="mt-20" aria-labelledby="principios">
      <h2 id="principios" class="titulo-2">
        {t('principios')}
      </h2>
      <ul
        class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"
        data-escalonado
      >
        {principios.map(([clave, Icono]) => (
          <li class="tarjeta foco-luz gap-4">
            <span class="caja-icono">
              <Icono aria-hidden="true" />
            </span>
            <h3 class="font-display text-lg font-semibold">{t(clave)}</h3>
            <p class="text-[0.9375rem]">{t(`${clave}t`)}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="fotos">
      <h2 id="fotos" class="titulo-3 flex items-center gap-3">
        <Camera class="size-6 text-marca-600" aria-hidden="true" />
        {t('fotos')}
      </h2>
      <p class="mt-3">{t('fotosTexto')}</p>
      <ul class="mt-5 grid gap-2 sm:grid-cols-2">
        {Object.values(FOTOS).map((f) => (
          <li>
            <a
              href={f.url}
              target="_blank"
              rel="noreferrer noopener"
              class="text-marca-700 underline underline-offset-2"
            >
              {t('foto', { autor: f.autor })}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <PanelCta
    idioma={idioma}
    titulo={tcta('titulo')}
    texto={tcta('texto')}
    boton={tcta('boton')}
  />
</Base>
