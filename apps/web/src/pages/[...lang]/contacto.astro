---
import { ArrowRight, Mail } from 'lucide-preact';
import PaginaTexto from '@/componentes/pagina/PaginaTexto.astro';
import { traductor } from '@/i18n/catalogos';
import { idiomaDe, ruta, rutasIdioma } from '@/i18n/idiomas';
import Base from '@/layouts/Base.astro';
import { EMAIL_CONTACTO, EMAIL_ES_PROVISIONAL } from '@/lib/sitio';

export const getStaticPaths = rutasIdioma;
const idioma = idiomaDe(Astro.params.lang);
const t = traductor(idioma, 'contacto');
const tco = traductor(idioma, 'colabora');
---

<Base
  idioma={idioma}
  ruta="/contacto"
  titulo={t('metaTitulo')}
  descripcion={t('metaDescripcion')}
>
  <PaginaTexto
    idioma={idioma}
    eyebrow={t('eyebrow')}
    titulo={t('titulo')}
    entradilla={t('entradilla')}
  >
    <p class="text-lg">
      {t('email')}
      <a
        href={`mailto:${EMAIL_CONTACTO}`}
        class="inline-flex items-center gap-2 font-semibold"
      >
        <Mail class="size-5" aria-hidden="true" />
        {EMAIL_CONTACTO}
      </a>
    </p>
    {EMAIL_ES_PROVISIONAL ? (
      <p class="rounded-2xl border border-pendiente-borde bg-pendiente-fondo p-4 text-sm text-pendiente-texto">
        {tco('provisional')}
      </p>
    ) : null}
    <p>{t('colabora')}</p>
    <p>
      <a
        href={ruta('/colabora', idioma)}
        class="boton boton--contorno boton--sm"
      >
        {t('colaboraBoton')}
        <ArrowRight aria-hidden="true" />
      </a>
    </p>
    <p class="text-texto-3">{t('noAsesoramiento')}</p>
  </PaginaTexto>
</Base>
