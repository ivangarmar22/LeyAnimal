---
import {
  ArrowRight,
  Dog,
  HeartCrack,
  Home,
  Search,
  Siren,
  Truck,
} from 'lucide-preact';
import FuentePlegable from '@/componentes/legal/FuentePlegable.astro';
import CabeceraPagina from '@/componentes/pagina/CabeceraPagina.astro';
import PanelCta from '@/componentes/pagina/PanelCta.astro';
import { traductor } from '@/i18n/catalogos';
import { idiomaDe, ruta, rutasIdioma } from '@/i18n/idiomas';
import Base from '@/layouts/Base.astro';

export const getStaticPaths = rutasIdioma;
const idioma = idiomaDe(Astro.params.lang);
const t = traductor(idioma, 'queHacerSi');
const tc = traductor(idioma, 'comun');
const tcta = traductor(idioma, 'inicio.cta');

const L7 = 'ley-7-2023-bienestar-animal';
const RD = 'rd-287-2002-animales-potencialmente-peligrosos';
const CASOS = [
  {
    clave: 'perdido',
    Icono: Search,
    ids: [`${L7}#art. 24.2.g`, `${L7}#art. 22.1`, `${RD}#art. 8.6`],
  },
  { clave: 'encontrado', Icono: Dog, ids: [`${L7}#art. 22.1`] },
  {
    clave: 'mordedura',
    Icono: Siren,
    ids: [`${L7}#art. 24.3`, `${RD}#art. 2.2`],
  },
  {
    clave: 'maltrato',
    Icono: HeartCrack,
    ids: [`${L7}#art. 74.k`, `${L7}#art. 75.a`],
  },
  { clave: 'mudanza', Icono: Truck, ids: [], enlace: '/comunidades' },
  { clave: 'muerte', Icono: Home, ids: [`${L7}#art. 26.j`] },
];
---

<Base
  idioma={idioma}
  ruta="/que-hacer-si"
  titulo={t('metaTitulo')}
  descripcion={t('metaDescripcion')}
>
  <CabeceraPagina
    idioma={idioma}
    eyebrow={t('eyebrow')}
    titulo={t('titulo')}
    entradilla={t('entradilla')}
    solape
  />

  <div class="contenedor solape pb-[var(--seccion)]">
    <div class="grid gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-14">
      <nav
        class="indice hidden lg:sticky lg:top-[calc(var(--cabecera)+32px)] lg:block lg:self-start lg:pt-40"
        aria-label={t('indice')}
      >
        <p class="rotulo mb-3">{t('indice')}</p>
        {CASOS.map(({ clave }) => (
          <a href={`#${clave}`}>{t(`casos.${clave}.titulo`)}</a>
        ))}
      </nav>

      <div class="grid gap-5">
        {CASOS.map(({ clave, Icono, ids, enlace }) => (
          <section
            id={clave}
            class="tarjeta scroll-mt-28 gap-6 shadow-media"
            aria-labelledby={`h-${clave}`}
          >
            <div class="flex items-center gap-4">
              <span class="caja-icono">
                <Icono aria-hidden="true" />
              </span>
              <h2 id={`h-${clave}`} class="titulo-3">
                {t(`casos.${clave}.titulo`)}
              </h2>
            </div>
            <ol class="grid gap-3">
              {(t.raw(`casos.${clave}.pasos`) as string[]).map((paso, n) => (
                <li class="flex gap-4">
                  <span class="grid size-7 shrink-0 place-items-center rounded-full bg-marca-50 text-xs font-semibold text-marca-700">
                    {n + 1}
                  </span>
                  <span class="pt-0.5">{paso}</span>
                </li>
              ))}
            </ol>
            {ids.length > 0 ? (
              <div class="border-t border-borde pt-2">
                <FuentePlegable idioma={idioma} ids={ids} />
              </div>
            ) : null}
            {enlace ? (
              <a href={ruta(enlace, idioma)} class="enlace-flecha self-start">
                {t('consulta')}
                <ArrowRight aria-hidden="true" />
              </a>
            ) : null}
          </section>
        ))}
        <p class="mt-6 text-sm font-medium text-texto-2">{tc('descargo')}</p>
      </div>
    </div>
  </div>

  <PanelCta
    idioma={idioma}
    titulo={tcta('titulo')}
    texto={tcta('texto')}
    boton={tcta('boton')}
  />
</Base>
