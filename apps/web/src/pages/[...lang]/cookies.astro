---
import PaginaTexto from '@/componentes/pagina/PaginaTexto.astro';
import { traductor } from '@/i18n/catalogos';
import { idiomaDe, rutasIdioma } from '@/i18n/idiomas';
import Base from '@/layouts/Base.astro';

export const getStaticPaths = rutasIdioma;
const idioma = idiomaDe(Astro.params.lang);
const t = traductor(idioma, 'cookies');
// Lo unico que se guarda: la preferencia de tema, y solo si se cambia.
const filas = [['tema', t('local'), t('tema'), t('indefinida')]];
---

<Base
  idioma={idioma}
  ruta="/cookies"
  titulo={t('metaTitulo')}
  descripcion={t('metaDescripcion')}
>
  <PaginaTexto
    idioma={idioma}
    eyebrow={t('eyebrow')}
    titulo={t('titulo')}
    entradilla={t('entradilla')}
  >
    <h2>{t('tabla')}</h2>
    <div class="rounded-2xl border border-borde md:p-2">
      <table class="tabla tabla--apilable">
        <thead>
          <tr>
            <th scope="col">{t('colNombre')}</th>
            <th scope="col">{t('colTipo')}</th>
            <th scope="col">{t('colFinalidad')}</th>
            <th scope="col">{t('colDuracion')}</th>
          </tr>
        </thead>
        <tbody>
          {filas.map(([nombre, tipo, finalidad, duracion]) => (
            <tr>
              <td class="font-mono text-sm text-texto">{nombre}</td>
              <td data-etiqueta={t('colTipo')}>{tipo}</td>
              <td data-etiqueta={t('colFinalidad')}>{finalidad}</td>
              <td data-etiqueta={t('colDuracion')}>{duracion}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{t('exencion')}</p>
    <p>{t('borrar')}</p>
  </PaginaTexto>
</Base>
