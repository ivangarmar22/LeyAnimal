---
import { Picture } from 'astro:assets';
import {
  ArrowRight,
  BadgeCheck,
  BookOpen,
  CalendarCheck,
  Check,
  CircleHelp,
  Gavel,
  HandCoins,
  HeartHandshake,
  Quote,
  ShieldAlert,
  Siren,
} from 'lucide-preact';
import Maqueta from '@/componentes/inicio/Maqueta.astro';
import TrazoMarca from '@/componentes/marca/TrazoMarca.astro';
import ListaPreguntas from '@/componentes/pagina/ListaPreguntas.astro';
import PanelCta from '@/componentes/pagina/PanelCta.astro';
import JsonLd from '@/componentes/seo/JsonLd.astro';
import { textosPara, traductor } from '@/i18n/catalogos';
import { idiomaDe, ruta, rutasIdioma } from '@/i18n/idiomas';
import SelectorRapido from '@/islas/SelectorRapido';
import Base from '@/layouts/Base.astro';
import { ICONOS_TEMA } from '@/lib/contenido/iconos';
import { FOTOS } from '@/lib/contenido/fotos';
import { PREGUNTAS_PORTADA } from '@/lib/contenido/preguntas';
import {
  cifras,
  comunidades,
  fuentesDe,
  normas,
  reglas,
  requisito,
  situacionComunidad,
  temas,
  ultimaVerificacion,
} from '@/lib/datos';
import { nombreNorma, textosRequisito, textosTema } from '@/lib/datos/textos';
import { formatearFecha, formatearNumero } from '@/lib/fechas';
import { urlAbsoluta } from '@/lib/seo';
import { URL_SITIO } from '@/lib/sitio';
import { ChipAmbito, ChipEstado } from '@/ui/Chips';

export const getStaticPaths = rutasIdioma;
const idioma = idiomaDe(Astro.params.lang);
const tg = traductor(idioma);
const t = tg.en('inicio');
const tm = tg.en('meta');

const c = cifras();
const verificada = ultimaVerificacion();
const fecha = (iso: string) => formatearFecha(iso, idioma);

/** Casillas del bento: las dos primeras, anchas. */
const ANCHO_TEMA: Record<string, number> = {
  seguro: 3,
  identificacion: 3,
  curso: 2,
  ppp: 2,
  esterilizacion: 2,
};

// Estado de la ley: lo que exigen las reglas estatales, tal cual.
const estatales = reglas()
  .filter((r) => r.ambito === 'estatal')
  .flatMap((r) => {
    const req = requisito(r.requisito);
    const fuente = fuentesDe(r.id)[0];
    return req && fuente ? [{ regla: r, requisito: req, fuente }] : [];
  })
  .sort(
    (a, b) =>
      (a.regla.estado === 'obligatorio' ? -1 : 0) -
      (b.regla.estado === 'obligatorio' ? -1 : 0),
  );

const ultimas = [...normas()]
  .filter((n) => n.verificadaEn && n.estado === 'vigente')
  .sort((a, b) => (b.verificadaEn ?? '').localeCompare(a.verificadaEn ?? ''))
  .slice(0, 4);

const recursos = [
  ['/perros-potencialmente-peligrosos', 'ppp', ShieldAlert],
  ['/multas', 'multas', Gavel],
  ['/que-hacer-si', 'queHacer', Siren],
  ['/seguros', 'seguros', HandCoins],
] as const;

const confianza = [
  ['f1', Quote],
  ['f2', CalendarCheck],
  ['f3', CircleHelp],
  ['f4', HeartHandshake],
] as const;

const cifrasTira = [
  ['comunidades', c.comunidades],
  ['municipios', c.municipios],
  ['normas', c.normas],
  ['articulos', c.articulos],
] as const;
---

<Base
  idioma={idioma}
  ruta="/"
  titulo={tm('titulo')}
  descripcion={tm('descripcion')}
  tituloCompleto
>
  <JsonLd
    datos={{
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'LeyAnimal',
      url: urlAbsoluta('/', idioma),
      description: tm('descripcion'),
      inLanguage: idioma,
      publisher: { '@type': 'Organization', name: 'LeyAnimal', url: URL_SITIO },
    }}
  />

  <!-- 1. Hero -->
  <section class="hero tinte">
    <div class="fondo-rejilla" aria-hidden="true"></div>
    <div class="fondo-brillo" aria-hidden="true"></div>
    <TrazoMarca
      id="trazo-hero"
      class="top-28 -right-44 hidden w-[640px] opacity-70 xl:block"
    />

    <div class="contenedor grid items-center gap-14 pb-14 lg:pb-20 xl:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] xl:gap-16">
      <div class="max-w-[720px] xl:max-w-none">
        <p class="eyebrow" data-intro>
          {t('hero.eyebrow', {
            comunidades: c.comunidades,
            municipios: formatearNumero(c.municipios, idioma),
          })}
        </p>
        <h1 class="titulo-1 mt-6" data-intro style="--i: 1">
          {t('hero.titulo1')} <span class="destacado">{t('hero.titulo2')}</span>
        </h1>
        <p class="entradilla mt-6" data-intro style="--i: 2">
          {t('hero.entradilla')}
        </p>
        <div class="mt-9" data-intro style="--i: 3">
          <SelectorRapido
            client:idle
            idioma={idioma}
            textos={textosPara(idioma, ['inicio.hero', 'especies'])}
          />
        </div>
        <ul
          class="mt-6 flex flex-wrap items-center gap-2"
          data-intro
          style="--i: 4"
        >
          {(['sinRegistro', 'citas', 'gratis'] as const).map((clave) => (
            <li class="pastilla">
              <Check aria-hidden="true" />
              {t(`hero.${clave}`)}
            </li>
          ))}
          <li>
            <a
              href={ruta('/metodologia', idioma)}
              class="enlace-flecha ml-2 py-1.5 text-sm"
            >
              {t('hero.metodo')}
              <ArrowRight aria-hidden="true" />
            </a>
          </li>
        </ul>
      </div>

      <div
        class="hidden md:block md:max-w-[640px] xl:max-w-none"
        data-intro
        style="--i: 3"
      >
        <Maqueta idioma={idioma} />
      </div>
    </div>

    <div class="contenedor pb-4">
      <dl class="tira">
        {cifrasTira.map(([clave, valor]) => (
          <div>
            <dt class="sr-only">{t(`cifras.${clave}`)}</dt>
            <dd>
              <strong data-cuenta={valor}>
                {formatearNumero(valor, idioma)}
              </strong>
              <span aria-hidden="true">{t(`cifras.${clave}`)}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 2. Contraste -->
  <section class="seccion">
    <div class="contenedor grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-20">
      <div
        class="lg:sticky lg:top-[calc(var(--cabecera)+40px)] lg:self-start"
        data-aparece
      >
        <p class="eyebrow">{t('contraste.eyebrow')}</p>
        <h2 class="titulo-2 mt-5">{t('contraste.titulo')}</h2>
        <p class="entradilla mt-5">{t('contraste.texto')}</p>
      </div>
      <div>
        <div class="rotulo mb-2 hidden grid-cols-[44px_minmax(0,1fr)] gap-4 sm:grid">
          <span></span>
          <span>
            {t('contraste.antes')} → {t('contraste.despues')}
          </span>
        </div>
        {(['p1', 'p2', 'p3', 'p4'] as const).map((p, n) => (
          <div class="contraste" data-aparece="fundido">
            <span class="contraste__num">{n + 1}</span>
            <p class="contraste__antes">
              <span class="sr-only">{t('contraste.antes')}: </span>
              <span>{t(`contraste.${p}a`)}</span>
            </p>
            <p class="contraste__despues">
              <BadgeCheck aria-hidden="true" />
              <span>
                <span class="sr-only">{t('contraste.despues')}: </span>
                {t(`contraste.${p}b`)}
              </span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Estado de la ley -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="cabeza-seccion cabeza-seccion--doble" data-aparece>
        <p class="eyebrow">{t('estado.eyebrow')}</p>
        <h2 class="titulo-2">{t('estado.titulo')}</h2>
        <p class="entradilla">{t('estado.texto')}</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2" data-escalonado>
        {estatales.map(({ regla, requisito: req, fuente }) => {
          const textos = textosRequisito(tg.en('requisitos'), req);
          return (
            <article class="tarjeta foco-luz gap-4">
              <div class="flex flex-wrap gap-2">
                <ChipEstado estado={regla.estado} t={tg} />
                <ChipAmbito ambito={regla.ambito} t={tg} />
              </div>
              <h3 class="titulo-3">{textos.titulo}</h3>
              <p>{textos.descripcion}</p>
              <a
                href={fuente.url}
                target="_blank"
                rel="noreferrer noopener"
                class="mt-auto inline-flex items-center gap-2 border-t border-borde pt-4 text-sm font-medium text-marca-700"
              >
                <Quote class="size-4" aria-hidden="true" />
                {t('estado.fuente', {
                  norma: nombreNorma(fuente.norma),
                  articulo: fuente.articulo.referencia,
                })}
              </a>
            </article>
          );
        })}
      </div>
      <a
        href={ruta('/comunidades', idioma)}
        class="enlace-flecha mt-10"
        data-aparece
      >
        {t('estado.enlace')}
        <ArrowRight aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- 4. Como funciona -->
  <section class="seccion relative isolate overflow-hidden">
    <div class="fondo-rejilla" aria-hidden="true"></div>
    <div class="contenedor">
      <div class="cabeza-seccion" data-aparece>
        <p class="eyebrow">{t('pasos.eyebrow')}</p>
        <h2 class="titulo-2">{t('pasos.titulo')}</h2>
        <p class="entradilla">{t('pasos.texto')}</p>
      </div>
      <ol class="pasos-fila" data-escalonado>
        {(['p1', 'p2', 'p3'] as const).map((p, n) => (
          <li class="relative">
            <span class="paso__nodo" aria-hidden="true">
              {n + 1}
            </span>
            <h3 class="mt-6 font-display text-xl">{t(`pasos.${p}`)}</h3>
            <p class="mt-2.5 max-w-[34ch]">{t(`pasos.${p}t`)}</p>
          </li>
        ))}
      </ol>
      <a
        href={ruta('/consulta', idioma)}
        class="boton boton--principal boton--lg mt-14"
        data-aparece
      >
        {t('cta.boton')}
        <ArrowRight aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- 5. Guias (bento) -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="cabeza-seccion cabeza-seccion--doble" data-aparece>
        <p class="eyebrow">{t('guias.eyebrow')}</p>
        <h2 class="titulo-2">{t('guias.titulo')}</h2>
        <p class="entradilla">{t('guias.texto')}</p>
      </div>
      <div class="bento" data-escalonado>
        {temas().map((tema) => {
          const Icono = ICONOS_TEMA[tema.clave] ?? BookOpen;
          const textos = textosTema(tg.en('temas'), tema);
          const ancho = ANCHO_TEMA[tema.clave] ?? 2;
          return (
            <a
              href={ruta(`/temas/${tema.slug}`, idioma)}
              class:list={[
                'tarjeta foco-luz gap-5',
                ancho === 3 && 'bento__ancha',
              ]}
              style={`grid-column: span ${ancho}`}
            >
              <span class="esquinas" aria-hidden="true">
                <i />
                <i />
                <i />
                <i />
              </span>
              <span class="caja-icono">
                <Icono aria-hidden="true" />
              </span>
              <span>
                <span class="titulo-3 block font-display font-semibold text-texto">
                  {textos.nombre}
                </span>
                <span class="mt-2 block">{textos.descripcion}</span>
              </span>
              <span class="enlace-flecha mt-auto text-[0.9375rem]">
                {t('guias.leer')}
                <ArrowRight aria-hidden="true" />
              </span>
            </a>
          );
        })}
        {recursos.map(([href, clave, Icono]) => (
          <a
            href={ruta(href, idioma)}
            class="tarjeta tarjeta--menta foco-luz gap-4"
            style="grid-column: span 3"
          >
            <span class="esquinas" aria-hidden="true">
              <i />
              <i />
              <i />
              <i />
            </span>
            <span class="flex items-center gap-4">
              <span class="caja-icono">
                <Icono aria-hidden="true" />
              </span>
              <span class="font-display text-lg font-semibold text-texto">
                {t(`guias.${clave}`)}
              </span>
            </span>
            <span>{t(`guias.${clave}Texto`)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Por que fiarte -->
  <section class="seccion overflow-hidden">
    <div class="contenedor grid items-center gap-16 lg:grid-cols-2 lg:gap-24">
      <div class="marco-foto order-2 lg:order-1" data-aparece="recorte">
        <div class="overflow-hidden rounded-[28px]">
          <Picture
            src={FOTOS.gatoVentana.imagen}
            formats={['avif', 'webp']}
            alt={t('confianza.altFoto')}
            widths={[480, 720, 1080]}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <div class="insignia-cristal">
          <span class="flex items-center gap-2.5 font-semibold">
            <BadgeCheck class="size-5 text-marca-600" aria-hidden="true" />
            {t('confianza.insignia', { citas: c.articulos })}
          </span>
          {verificada ? (
            <span class="text-sm text-texto-2">
              {t('confianza.insigniaTexto', { fecha: fecha(verificada) })}
            </span>
          ) : null}
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <div data-aparece>
          <p class="eyebrow">{t('confianza.eyebrow')}</p>
          <h2 class="titulo-2 mt-5">{t('confianza.titulo')}</h2>
          <p class="entradilla mt-5">{t('confianza.texto')}</p>
        </div>
        <ul class="mt-10 grid gap-7 sm:grid-cols-2" data-escalonado>
          {confianza.map(([clave, Icono]) => (
            <li class="flex gap-4">
              <span class="caja-icono size-11">
                <Icono aria-hidden="true" />
              </span>
              <span>
                <span class="block font-display font-semibold text-texto">
                  {t(`confianza.${clave}`)}
                </span>
                <span class="mt-1 block text-[0.9375rem]">
                  {t(`confianza.${clave}t`)}
                </span>
              </span>
            </li>
          ))}
        </ul>
        <a
          href={ruta('/metodologia', idioma)}
          class="enlace-flecha mt-10"
          data-aparece
        >
          {t('confianza.metodo')}
          <ArrowRight aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- 7. Comunidades -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="cabeza-seccion cabeza-seccion--doble" data-aparece>
        <p class="eyebrow">{t('comunidades.eyebrow')}</p>
        <h2 class="titulo-2">{t('comunidades.titulo')}</h2>
        <p class="entradilla">{t('comunidades.texto')}</p>
      </div>
      <ul
        class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"
        data-escalonado="fundido"
      >
        {comunidades().map((com) => {
          const s = situacionComunidad(com.codigoIne);
          const texto =
            s.tipo === 'reglas'
              ? t('comunidades.reglas', { n: s.reglas })
              : s.tipo === 'sinLey'
                ? t('comunidades.sinLey')
                : s.tipo === 'ordenanzas'
                  ? t('comunidades.ordenanzas')
                  : t('comunidades.pendiente');
          const punto =
            s.tipo === 'reglas'
              ? 'bg-marca-500'
              : s.tipo === 'pendiente'
                ? 'bg-pendiente-texto'
                : 'bg-texto-3';
          return (
            <li>
              <a
                href={ruta(`/comunidades/${com.slug}`, idioma)}
                class="group flex h-full items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-marca-300"
              >
                <span>
                  <span class="block font-medium text-texto">{com.nombre}</span>
                  <span class="mt-0.5 flex items-center gap-1.5 text-sm text-texto-3">
                    <span
                      class={`size-1.5 rounded-full ${punto}`}
                      aria-hidden="true"
                    />
                    {texto}
                  </span>
                </span>
                <ArrowRight
                  class="size-4 shrink-0 text-texto-3 transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </a>
            </li>
          );
        })}
      </ul>
      <a href={ruta('/mapa', idioma)} class="enlace-flecha mt-10" data-aparece>
        {t('comunidades.mapa')}
        <ArrowRight aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- 8. Verificaciones -->
  <section class="seccion">
    <div class="contenedor grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <div data-aparece>
        <p class="eyebrow">{t('cambios.eyebrow')}</p>
        <h2 class="titulo-2 mt-5">{t('cambios.titulo')}</h2>
        <p class="entradilla mt-5">{t('cambios.texto')}</p>
        <a href={ruta('/cambios', idioma)} class="enlace-flecha mt-8">
          {t('cambios.todos')}
          <ArrowRight aria-hidden="true" />
        </a>
      </div>
      <ul class="grid gap-3" data-escalonado>
        {ultimas.map((n) => (
          <li>
            <a
              href={ruta(`/normativa/${n.slug}`, idioma)}
              class="tarjeta tarjeta--interactiva flex-row items-center gap-4 p-5"
            >
              <span class="caja-icono size-11">
                <BookOpen aria-hidden="true" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-medium text-texto">
                  {nombreNorma(n)}
                </span>
                {n.verificadaEn ? (
                  <span class="mt-0.5 block text-sm text-texto-3">
                    {t('cambios.verificada', { fecha: fecha(n.verificadaEn) })}
                  </span>
                ) : null}
              </span>
              <span class="hidden shrink-0 sm:block">
                <ChipAmbito ambito={n.ambito} t={tg} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 9. Preguntas -->
  <section class="seccion seccion--suave">
    <div class="contenedor grid gap-12 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-20">
      <div data-aparece>
        <p class="eyebrow">{t('faq.eyebrow')}</p>
        <h2 class="titulo-2 mt-5">{t('faq.titulo')}</h2>
        <a
          href={ruta('/preguntas-frecuentes', idioma)}
          class="enlace-flecha mt-8"
        >
          {t('faq.todas')}
          <ArrowRight aria-hidden="true" />
        </a>
      </div>
      <ListaPreguntas
        idioma={idioma}
        claves={PREGUNTAS_PORTADA}
        abiertaPrimera
      />
    </div>
  </section>

  <div class="pt-[var(--seccion)]">
    <PanelCta
      idioma={idioma}
      titulo={t('cta.titulo')}
      texto={t('cta.texto')}
      boton={t('cta.boton')}
      secundario={{ texto: t('cta.secundario'), href: '/normativa' }}
    />
  </div>
</Base>
