---
import { CircleCheck, Home, Info, Scale, ShieldAlert } from 'lucide-preact';
import TablaComunidades from '@/componentes/obligaciones/TablaComunidades.astro';
import CabeceraPagina from '@/componentes/pagina/CabeceraPagina.astro';
import PanelCta from '@/componentes/pagina/PanelCta.astro';
import { traductor } from '@/i18n/catalogos';
import { idiomaDe, rutasIdioma } from '@/i18n/idiomas';
import Base from '@/layouts/Base.astro';
import { articulo, norma, reglasDeRequisito } from '@/lib/datos';
import { requisitoPorComunidad } from '@/lib/datos/evaluacion';
import { ChipAmbito, ChipEstado } from '@/ui/Chips';
import { CitaLegal } from '@/ui/CitaLegal';

export const getStaticPaths = rutasIdioma;
const idioma = idiomaDe(Astro.params.lang);
const tg = traductor(idioma);
const t = tg.en('seguros');
const tn = tg.en('navegacion');

const cita = (id: string) => {
  const a = articulo(id);
  const n = a ? norma(a.norma) : undefined;
  if (!a || !n) throw new Error(`Falta el articulo ${id}`);
  return { a, n };
};
const estatal = (clave: string) =>
  reglasDeRequisito(clave).find((r) => r.ambito === 'estatal')?.estado;
const bloques = [
  {
    titulo: t('estatal'),
    texto: t('estatalTexto'),
    estado: estatal('seguro_rc_perros'),
    Icono: Scale,
    color: 'text-marca-600',
    ...cita('ley-7-2023-bienestar-animal#art. 30.3'),
  },
  {
    titulo: t('ppp'),
    texto: t('pppTexto'),
    estado: estatal('licencia_ppp'),
    Icono: ShieldAlert,
    color: 'text-obligatorio-texto',
    ...cita('rd-287-2002-animales-potencialmente-peligrosos#art. 3.1.e'),
  },
];
const preguntas = ['p1', 'p2', 'p3', 'p4', 'p5', 'p6'] as const;
---

<Base
  idioma={idioma}
  ruta="/seguros"
  titulo={t('metaTitulo')}
  descripcion={t('metaDescripcion')}
>
  <CabeceraPagina
    idioma={idioma}
    eyebrow={t('eyebrow')}
    titulo={t('titulo')}
    entradilla={t('entradilla')}
    migas={[{ nombre: tn('temas'), href: '/temas' }]}
    actual={tn('seguros')}
    solape
  >
    <p class="flex items-center gap-2 text-sm text-texto-3">
      <Info class="size-4" aria-hidden="true" />
      {t('aviso')}
    </p>
  </CabeceraPagina>

  <div class="contenedor solape pb-[var(--seccion)]">
    <div class="grid gap-5 lg:grid-cols-2">
      {bloques.map(({ titulo, texto, estado, Icono, color, a, n }) => (
        <section class="tarjeta gap-4 shadow-alta">
          <div class="flex flex-wrap gap-2">
            {estado ? <ChipEstado estado={estado} t={tg} /> : null}
            <ChipAmbito ambito="estatal" t={tg} />
          </div>
          <h2 class="titulo-3 flex items-center gap-3">
            <Icono class={`size-6 ${color}`} aria-hidden="true" />
            {titulo}
          </h2>
          <p>{texto}</p>
          <CitaLegal norma={n} articulo={a} t={tg} />
        </section>
      ))}
    </div>

    <section class="mt-20" aria-labelledby="territorios">
      <h2 id="territorios" class="titulo-2">
        {t('territorios')}
      </h2>
      <p class="entradilla mt-4">{t('territoriosTexto')}</p>
      <div class="mt-8">
        <TablaComunidades
          idioma={idioma}
          filas={requisitoPorComunidad('seguro_rc_perros')}
          caption={t('territorios')}
        />
      </div>
    </section>

    <section class="mt-20 grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="titulo-3 flex items-center gap-3">
          <Home class="size-6 text-marca-600" aria-hidden="true" />
          {t('hogar')}
        </h2>
        <p class="mt-4 max-w-[60ch]">{t('hogarTexto')}</p>
      </div>
      <div class="tarjeta seccion--suave gap-4">
        <h2 class="titulo-3">{t('preguntas')}</h2>
        <ul class="grid gap-4">
          {preguntas.map((p) => (
            <li class="flex gap-3">
              <CircleCheck
                class="mt-0.5 size-5 shrink-0 text-marca-600"
                aria-hidden="true"
              />
              <span>
                <span class="font-medium text-texto">{t(p)}</span>
                {p === 'p2' ? (
                  <span class="mt-1 block text-sm text-texto-3">
                    {t('p2nota')}
                  </span>
                ) : null}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <p class="mt-12 text-sm font-medium text-texto-2">{tg('comun.descargo')}</p>
  </div>

  <PanelCta
    idioma={idioma}
    titulo={tg('inicio.cta.titulo')}
    texto={tg('inicio.cta.texto')}
    boton={tg('inicio.cta.boton')}
  />
</Base>
