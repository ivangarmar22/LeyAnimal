---
import PaginaTexto from '@/componentes/pagina/PaginaTexto.astro';
import { traductor } from '@/i18n/catalogos';
import { idiomaDe, rutasIdioma } from '@/i18n/idiomas';
import Base from '@/layouts/Base.astro';
import { EMAIL_CONTACTO, TITULAR } from '@/lib/sitio';

export const getStaticPaths = rutasIdioma;
const idioma = idiomaDe(Astro.params.lang);
const t = traductor(idioma, 'privacidad');
---

<Base
  idioma={idioma}
  ruta="/privacidad"
  titulo={t('metaTitulo')}
  descripcion={t('metaDescripcion')}
>
  <PaginaTexto
    idioma={idioma}
    eyebrow={t('eyebrow')}
    titulo={t('titulo')}
    entradilla={t('entradilla')}
    pendiente={!TITULAR.nombre}
  >
    <h2>{t('resumen')}</h2>
    <ul>
      {(t.raw('lista') as string[]).map((p) => (
        <li>{p}</li>
      ))}
    </ul>
    <h2>{t('alojamiento')}</h2>
    <p>{t('alojamientoTexto')}</p>
    <h2>{t('derechos')}</h2>
    <p>{t('derechosTexto', { email: EMAIL_CONTACTO })}</p>
    <h2>{t('responsable')}</h2>
    <p>{t('responsableTexto')}</p>
  </PaginaTexto>
</Base>
