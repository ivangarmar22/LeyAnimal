---
import { History, Rss } from 'lucide-preact';
import CabeceraPagina from '@/componentes/pagina/CabeceraPagina.astro';
import { traductor } from '@/i18n/catalogos';
import { idiomaDe, ruta, rutasIdioma } from '@/i18n/idiomas';
import Base from '@/layouts/Base.astro';
import { cambios, normas } from '@/lib/datos';
import { nombreNorma } from '@/lib/datos/textos';
import { formatearFecha } from '@/lib/fechas';
import { ChipAmbito, ChipNorma } from '@/ui/Chips';

export const getStaticPaths = rutasIdioma;
const idioma = idiomaDe(Astro.params.lang);
const t = traductor(idioma, 'cambios');
const tg = traductor(idioma);
const fecha = (iso: string | null) => (iso ? formatearFecha(iso, idioma) : '—');

const lista = [...cambios()].sort((a, b) =>
  (b.publicadoEn ?? '').localeCompare(a.publicadoEn ?? ''),
);
const verificaciones = [...normas()].sort(
  (a, b) =>
    (b.verificadaEn ?? '').localeCompare(a.verificadaEn ?? '') ||
    nombreNorma(a).localeCompare(nombreNorma(b), 'es'),
);
---

<Base
  idioma={idioma}
  ruta="/cambios"
  titulo={t('metaTitulo')}
  descripcion={t('metaDescripcion')}
  conRss
>
  <CabeceraPagina
    idioma={idioma}
    eyebrow={t('eyebrow')}
    titulo={t('titulo')}
    entradilla={t('entradilla')}
    solape
  >
    <a href="/cambios/rss.xml" class="boton boton--contorno">
      <Rss aria-hidden="true" />
      {t('rss')}
    </a>
  </CabeceraPagina>

  <div class="contenedor solape pb-[var(--seccion)]">
    <section class="tarjeta gap-5 shadow-alta" aria-labelledby="lista-cambios">
      <h2 id="lista-cambios" class="titulo-3 flex items-center gap-3">
        <History class="size-6 text-marca-600" aria-hidden="true" />
        {t('cambiosTitulo')}
      </h2>
      {lista.length === 0 ? (
        <p class="max-w-[70ch]">{t('sinCambios')}</p>
      ) : (
        <ol class="grid gap-4">
          {lista.map((c) => (
            <li class="grid gap-1 border-l-2 border-marca-500 pl-4">
              <p class="rotulo">
                {t(`tipos.${c.tipo}`)} · {fecha(c.publicadoEn)}
              </p>
              <p class="font-medium text-texto">{c.titulo}</p>
              {c.resumen ? <p class="text-[0.9375rem]">{c.resumen}</p> : null}
            </li>
          ))}
        </ol>
      )}
    </section>

    <section class="mt-16" aria-labelledby="verificaciones">
      <h2 id="verificaciones" class="titulo-3">
        {t('verificaciones')}
      </h2>
      <p class="mt-2">{t('verificacionesTexto')}</p>
      <div class="mt-6 rounded-3xl border border-borde bg-superficie md:p-2">
        <table class="tabla tabla--apilable">
          <thead>
            <tr>
              <th scope="col">{t('colNorma')}</th>
              <th scope="col">{t('colAmbito')}</th>
              <th scope="col">{t('colEstado')}</th>
              <th scope="col">{t('colVerificada')}</th>
            </tr>
          </thead>
          <tbody>
            {verificaciones.map((n) => (
              <tr>
                <td>
                  <a
                    href={ruta(`/normativa/${n.slug}`, idioma)}
                    class="font-medium text-texto underline-offset-2 hover:underline"
                  >
                    {nombreNorma(n)}
                  </a>
                </td>
                <td data-etiqueta={t('colAmbito')}>
                  <ChipAmbito ambito={n.ambito} t={tg} />
                </td>
                <td data-etiqueta={t('colEstado')}>
                  <ChipNorma estado={n.estado} t={tg} />
                </td>
                <td data-etiqueta={t('colVerificada')} class="cifras">
                  {fecha(n.verificadaEn)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>
