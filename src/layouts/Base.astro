---
/**
 * Layout de todas las paginas: <head> con SEO (canonica y Open Graph),
 * cabecera, contenido y pie.
 */
import '@/estilos/global.css';
import Cabecera from '@/componentes/layout/Cabecera.astro';
import Pie from '@/componentes/layout/Pie.astro';
import { capasSimbolo, defsSimbolo } from '@/componentes/marca/formas';
import { traductor } from '@/i18n/catalogos';
import { ruta as rutaPublica } from '@/lib/rutas';
import { urlAbsoluta } from '@/lib/seo';

interface Props {
  /** Ruta de la pagina: '/consulta', '/municipios/malaga'. */
  ruta: string;
  titulo: string;
  descripcion: string;
  /** Sin el sufijo "| LeyAnimal" (portada). */
  tituloCompleto?: boolean;
  /** False en la 404: ni se indexa ni tiene canonica. */
  indexable?: boolean;
  /** Anuncia el feed RSS de cambios. */
  conRss?: boolean;
}

const {
  ruta,
  titulo,
  descripcion,
  tituloCompleto = false,
  indexable = true,
  conRss = false,
} = Astro.props;
const t = traductor('navegacion');
const titular = tituloCompleto ? titulo : `${titulo} | LeyAnimal`;
const canonica = urlAbsoluta(ruta);
const imagen = urlAbsoluta('/og/leyanimal.png');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titular}</title>
    <meta name="description" content={descripcion} />
    {indexable ? (
      <link rel="canonical" href={canonica} />
    ) : (
      <meta name="robots" content="noindex, follow" />
    )}
    {conRss && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title="LeyAnimal"
        href={rutaPublica('/cambios/rss.xml')}
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LeyAnimal" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="LeyAnimal: lo que la ley te exige con tu animal, en tu municipio y al día"
    />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#effaf4" />
    <link rel="icon" href={rutaPublica('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={rutaPublica('/apple-touch-icon.png')} />
    <link
      rel="preload"
      href={rutaPublica('/fuentes/geist.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={rutaPublica('/fuentes/sora.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Marca que hay JavaScript antes del primer pintado: activa las animaciones -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <!-- Simbolo del logotipo y sus degradados, una vez por pagina (Simbolo.astro) -->
    <svg class="defs-marca" aria-hidden="true" focusable="false">
      <defs
        set:html={
          defsSimbolo('la') +
          `<symbol id="la-simbolo" viewBox="0 0 48 52">${capasSimbolo('la')}</symbol>`
        }
      />
    </svg>
    <div class="flex min-h-dvh flex-col">
      <a
        href="#contenido"
        class="fixed top-[-80px] left-4 z-[100] rounded-full bg-superficie px-4 py-2.5 font-semibold text-texto shadow-media transition-[top] focus:top-3"
      >
        {t('saltarAlContenido')}
      </a>
      <Cabecera rutaActual={ruta} />
      <main id="contenido" class="flex-1">
        <slot />
      </main>
      <Pie />
    </div>
    <script>
      import '@/scripts/efectos';
    </script>
  </body>
</html>
