---
import { ArrowRight, MapPin, ShieldAlert } from 'lucide-preact';
import FuentePlegable from '@/componentes/legal/FuentePlegable.astro';
import TablaComunidades from '@/componentes/obligaciones/TablaComunidades.astro';
import CabeceraPagina from '@/componentes/pagina/CabeceraPagina.astro';
import PanelCta from '@/componentes/pagina/PanelCta.astro';
import JsonLd from '@/componentes/seo/JsonLd.astro';
import { traductor } from '@/i18n/catalogos';
import { ruta } from '@/lib/rutas';
import Base from '@/layouts/Base.astro';
import { guiaTema } from '@/lib/contenido/guias';
import { ICONOS_TEMA } from '@/lib/contenido/iconos';
import { documento } from '@/lib/contenido/ilustraciones';
import { Ilustracion } from '@/ui/Ilustracion';
import {
  articulo,
  fuentesDe,
  norma,
  normasDeRequisito,
  reglasDeRequisito,
  requisitos,
  tema,
  temas,
  ultimaVerificacion,
} from '@/lib/datos';
import { requisitoPorComunidad } from '@/lib/datos/evaluacion';
import {
  nombreNorma,
  notaRegla,
  parrafos,
  textosRequisito,
  textosTema,
} from '@/lib/datos/textos';
import type { Requisito } from '@/lib/datos/tipos';
import { anioActual, urlAbsoluta } from '@/lib/seo';
import { ChipAmbito, ChipEstado, ChipNeutro } from '@/ui/Chips';
import { CitaLegal } from '@/ui/CitaLegal';

export function getStaticPaths() {
  return temas().map((t) => ({ params: { slug: t.slug } }));
}

/**
 * La esterilizacion no tiene requisito propio: la obligacion estatal va unida
 * al microchip de los gatos (art. 26.i), asi que su guia la comparte.
 */
const EXTRA: Record<string, string[]> = {
  esterilizacion: ['microchip_esterilizacion_gatos'],
};
const requisitosDelTema = (clave: string): Requisito[] =>
  requisitos().filter(
    (r) => r.tema === clave || (EXTRA[clave] ?? []).includes(r.clave),
  );

const tm = tema(String(Astro.params.slug));
if (!tm) throw new Error(`Tema desconocido: ${Astro.params.slug}`);
const tg = traductor();
const t = tg.en('guia');
const textos = textosTema(tg.en('temas'), tm);
const lista = requisitosDelTema(tm.clave);
const guia = guiaTema(tm.clave);
const tt = tg.en(`temas.${tm.clave}`);
const Icono = ICONOS_TEMA[tm.clave] ?? documento;
const normasRelacionadas = [
  ...new Map(
    (guia
      ? [...(guia.intro ?? []), ...guia.puntos.flatMap((p) => p.ids)].map(
          (id) => norma(articulo(id)?.norma ?? ''),
        )
      : lista.flatMap((r) => normasDeRequisito(r.clave))
    )
      .filter((n) => n !== undefined)
      .map((n) => [n.slug, n]),
  ).values(),
];
const rutaPagina = `/temas/${tm.slug}`;
const metaTitulo = tt.has('metaTitulo')
  ? tt('metaTitulo', { anio: anioActual() })
  : t('metaTitulo', { tema: textos.nombre, anio: anioActual() });

const secciones = lista.map((req) => {
  const estatales = reglasDeRequisito(req.clave).filter(
    (r) => r.ambito === 'estatal',
  );
  const filas = requisitoPorComunidad(req.clave);
  return {
    req,
    txt: textosRequisito(req),
    estatales,
    filas,
    hayVariacion:
      new Set(filas.map((f) => f.obligacion?.resultado.estado)).size > 1 ||
      estatales.length === 0,
    especie:
      req.clave === 'licencia_ppp'
        ? t('unPerroPpp')
        : req.clave === 'microchip_esterilizacion_gatos'
          ? t('unGato')
          : t('unPerro'),
  };
});

// Con un solo requisito, su titulo va en el resumen y la seccion no lo repite.
const varias = guia !== undefined || secciones.length > 1;
const Sub = varias ? 'h3' : 'h2';
const indice = guia
  ? guia.puntos.map((p) => ({
      id: p.clave,
      titulo: tt(`puntos.${p.clave}.titulo`),
      descripcion: '',
    }))
  : secciones.map(({ req, txt }) => ({
      id: req.clave,
      titulo: txt.titulo,
      descripcion: txt.descripcion,
    }));
---

<Base ruta={rutaPagina} titulo={metaTitulo} descripcion={textos.descripcion}>
  <JsonLd
    slot="head"
    datos={{
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: textos.nombre,
      description: textos.descripcion,
      inLanguage: 'es',
      dateModified: ultimaVerificacion() ?? undefined,
      mainEntityOfPage: urlAbsoluta(rutaPagina),
      publisher: { '@type': 'Organization', name: 'LeyAnimal' },
    }}
  />
  <CabeceraPagina
    titulo={textos.nombre}
    entradilla={textos.descripcion}
    solape
  />

  <div class="contenedor solape pb-[var(--seccion)]">
    <div
      class:list={[
        'grid rounded-[28px] border border-borde bg-superficie p-5 shadow-alta sm:p-8 lg:p-12',
        guia ? 'gap-8' : 'gap-12',
      ]}
    >
      <section
        class="tarjeta tarjeta--menta flex-row items-start gap-4 shadow-none"
        aria-labelledby="h-resumen"
      >
        <span class="caja-icono hidden sm:grid">
          <Ilustracion icono={Icono} />
        </span>
        <div class="grid min-w-0 gap-3">
          <h2 id="h-resumen" class="rotulo">
            {varias ? t('enEstaGuia') : t('resumen')}
          </h2>
          <ul class:list={['grid', guia ? 'gap-2' : 'gap-4']}>
            {indice.map(({ id, titulo, descripcion }) => (
              <li class="text-[1.0625rem] leading-relaxed">
                {varias ? (
                  <a
                    href={`#${id}`}
                    class="block font-semibold text-marca-700 underline-offset-2 hover:underline"
                  >
                    {titulo}
                  </a>
                ) : (
                  <strong class="block font-semibold text-texto">
                    {titulo}
                  </strong>
                )}
                {descripcion ? (
                  <span class="text-texto-2">{descripcion}</span>
                ) : null}
              </li>
            ))}
          </ul>
        </div>
      </section>

      {guia?.intro ? (
        <section class="grid gap-4" aria-labelledby="h-intro">
          <h2 id="h-intro" class="titulo-2 text-[clamp(1.5rem,2.4vw,2rem)]">
            {tt('intro.titulo')}
          </h2>
          <p class="prosa max-w-none">{tt('intro.texto')}</p>
          <div class="border-t border-borde pt-2">
            <FuentePlegable ids={guia.intro} />
          </div>
        </section>
      ) : null}

      {guia?.puntos.map((p, i) => {
        const tp = tt.en(`puntos.${p.clave}`);
        return (
          <section
            id={p.clave}
            class:list={[
              'grid scroll-mt-28 gap-4',
              (i > 0 || guia.intro) && 'border-t border-borde pt-8',
            ]}
            aria-labelledby={`t-${p.clave}`}
          >
            <div class="flex flex-wrap items-center gap-2">
              {p.estado === 'depende' ? (
                <ChipNeutro Icono={MapPin} texto={tg('situaciones.depende')} />
              ) : (
                <ChipEstado estado={p.estado} t={tg} />
              )}
              {p.ppp ? (
                <ChipNeutro
                  Icono={ShieldAlert}
                  texto={tg('situaciones.soloPpp')}
                />
              ) : null}
            </div>
            <h2
              id={`t-${p.clave}`}
              class="titulo-2 text-[clamp(1.5rem,2.4vw,2rem)]"
            >
              {tp('titulo')}
            </h2>
            <p class="prosa max-w-none">{tp('texto')}</p>
            {p.ids.length > 0 ? (
              <div class="border-t border-borde pt-2">
                <FuentePlegable ids={p.ids} />
              </div>
            ) : null}
            {p.enlace ? (
              <a href={ruta(p.enlace)} class="enlace-flecha self-start">
                {tp('enlace')}
                <ArrowRight aria-hidden="true" />
              </a>
            ) : null}
          </section>
        );
      })}

      {secciones.map(
        ({ req, txt, estatales, filas, hayVariacion, especie }, i) => (
          <section
            id={req.clave}
            class:list={[
              'grid scroll-mt-28 gap-8',
              i > 0 && 'border-t border-borde pt-12',
            ]}
            aria-labelledby={varias ? `t-${req.clave}` : undefined}
            aria-label={varias ? undefined : txt.titulo}
          >
            {varias ? (
              <h2
                id={`t-${req.clave}`}
                class="titulo-2 text-[clamp(1.5rem,2.4vw,2rem)]"
              >
                {txt.titulo}
              </h2>
            ) : null}

            {txt.explicacion ? (
              <div class="prosa max-w-none">
                {parrafos(txt.explicacion).map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            ) : null}

            {estatales.length > 0 ? (
              <div class="grid gap-4">
                <Sub class="rotulo">{t('estatal')}</Sub>
                {estatales.map((regla) => (
                  <div class="grid gap-3">
                    <div class="flex flex-wrap gap-2">
                      <ChipEstado estado={regla.estado} t={tg} />
                      <ChipAmbito ambito={regla.ambito} t={tg} />
                    </div>
                    {fuentesDe(regla.id).map((f) => (
                      <CitaLegal
                        norma={f.norma}
                        articulo={f.articulo}
                        cita={f.cita}
                        t={tg}
                      />
                    ))}
                    {notaRegla(regla) ? (
                      <p class="text-sm text-texto-3">{notaRegla(regla)}</p>
                    ) : null}
                  </div>
                ))}
              </div>
            ) : null}

            {hayVariacion ? (
              <div class="grid gap-4">
                <div>
                  <Sub class="titulo-3">{t('variacion')}</Sub>
                  <p class="mt-2 text-[0.9375rem]">
                    {t('variacionTexto', { especie })}
                  </p>
                </div>
                <TablaComunidades
                  filas={filas}
                  caption={`${txt.titulo}: ${t('variacion')}`}
                />
              </div>
            ) : null}

            {req.clave === 'licencia_ppp' ? (
              <a
                href={ruta('/perros-potencialmente-peligrosos')}
                class="enlace-flecha"
              >
                {t('enlacesPpp')}
                <ArrowRight aria-hidden="true" />
              </a>
            ) : null}
            {req.clave === 'seguro_rc_perros' ? (
              <a href={ruta('/seguros')} class="enlace-flecha">
                {t('enlacesSeguro')}
                <ArrowRight aria-hidden="true" />
              </a>
            ) : null}
          </section>
        ),
      )}

      {normasRelacionadas.length > 0 ? (
        <section class="border-t border-borde pt-10">
          <h2 class="titulo-3">{t('normas')}</h2>
          <ul class="mt-5 grid gap-3 md:grid-cols-2">
            {normasRelacionadas.map((n) => (
              <li>
                <a
                  href={ruta(`/normativa/${n.slug}`)}
                  class="flex items-center gap-3 rounded-2xl border border-borde px-4 py-3.5 transition-colors hover:border-marca-300"
                >
                  <ChipAmbito ambito={n.ambito} t={tg} />
                  <span class="min-w-0 flex-1 font-medium text-texto">
                    {nombreNorma(n)}
                  </span>
                  <ArrowRight class="size-4 text-texto-3" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      <p class="text-sm font-medium text-texto-2">{tg('comun.descargo')}</p>
    </div>
  </div>

  <PanelCta
    titulo={t('consulta')}
    texto={t('consultaTexto')}
    boton={tg('comun.empezarConsulta')}
  />
</Base>
