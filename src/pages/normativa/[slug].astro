---
import { ArrowRight, ChevronDown, ExternalLink } from 'lucide-preact';
import CabeceraPagina from '@/componentes/pagina/CabeceraPagina.astro';
import JsonLd from '@/componentes/seo/JsonLd.astro';
import { traductor } from '@/i18n/catalogos';
import { ruta } from '@/lib/rutas';
import Base from '@/layouts/Base.astro';
import {
  articulosDe,
  cambios,
  comunidad,
  norma,
  normas,
  reglasQueCitan,
  requisito,
  tema,
} from '@/lib/datos';
import {
  compararReferencias,
  nombreNorma,
  textosRequisito,
} from '@/lib/datos/textos';
import { formatearFecha } from '@/lib/fechas';
import { urlAbsoluta } from '@/lib/seo';
import { ChipAmbito, ChipEstado, ChipNorma } from '@/ui/Chips';
import { CitaLegal } from '@/ui/CitaLegal';

export function getStaticPaths() {
  return normas().map((n) => ({ params: { slug: n.slug } }));
}

const n = norma(String(Astro.params.slug));
if (!n) throw new Error(`Norma desconocido: ${Astro.params.slug}`);
const tg = traductor();
const t = tg.en('norma');
const fecha = (iso: string | null) => (iso ? formatearFecha(iso) : '—');

const c = n.comunidad ? comunidad(n.comunidad) : undefined;
const articulos = [...articulosDe(n.slug)].sort((a, b) =>
  compararReferencias(a.referencia, b.referencia),
);
const reglas = reglasQueCitan(n.slug);
const historial = cambios().filter((x) => x.norma === n.slug);
const boletin = n.identificadorBoletin?.startsWith('DOGC')
  ? 'publicadaEnDogc'
  : 'publicadaEnBoe';
const datos: [string, string][] = [
  [t('identificador'), n.identificadorBoletin ?? '—'],
  [t('ambito'), tg(`ambitos.${n.ambito}`)],
  [t('territorio'), c?.nombre ?? t('espana')],
  [
    t('publicacion'),
    n.fechaPublicacion
      ? tg(`ley.${boletin}`, { fecha: fecha(n.fechaPublicacion) })
      : '—',
  ],
  [t('vigor'), fecha(n.fechaEntradaVigor)],
  [t('verificada'), fecha(n.verificadaEn)],
];
const rutaPagina = `/normativa/${n.slug}`;
---

<Base
  ruta={rutaPagina}
  titulo={nombreNorma(n)}
  descripcion={t('metaDescripcion', { titulo: n.titulo })}
>
  <JsonLd
    slot="head"
    datos={{
      '@context': 'https://schema.org',
      '@type': 'Legislation',
      name: n.titulo,
      legislationIdentifier: n.identificadorBoletin ?? undefined,
      legislationDate: n.fechaPublicacion ?? undefined,
      legislationJurisdiction: c?.nombre ?? 'España',
      url: n.urlOficial,
      mainEntityOfPage: urlAbsoluta(rutaPagina),
      inLanguage: 'es',
    }}
  />
  <CabeceraPagina titulo={nombreNorma(n)} entradilla={n.titulo} solape>
    <div class="flex flex-wrap items-center gap-3">
      <a
        href={n.urlOficial}
        target="_blank"
        rel="noreferrer noopener"
        class="boton boton--principal"
      >
        {t('boletin')}
        <ExternalLink aria-hidden="true" />
        <span class="sr-only">{tg('comun.abreEnPestana')}</span>
      </a>
      <ChipNorma estado={n.estado} t={tg} />
      <ChipAmbito ambito={n.ambito} t={tg} />
      <span class="text-sm text-texto-3">{tg(`tiposNorma.${n.tipo}`)}</span>
    </div>
  </CabeceraPagina>

  <div class="contenedor solape pb-[var(--seccion)]">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_21rem] lg:gap-12">
      <div class="grid min-w-0 gap-12 rounded-[28px] border border-borde bg-superficie p-5 shadow-alta sm:p-8 lg:p-10">
        {n.resumen ? (
          <section>
            <h2 class="titulo-3">{t('resumen')}</h2>
            <p class="mt-3 max-w-[68ch]">{n.resumen}</p>
          </section>
        ) : null}

        <section>
          <h2 class="titulo-3">{t('articulos')}</h2>
          {articulos.length === 0 ? (
            <p class="mt-3">{t('sinArticulos')}</p>
          ) : (
            <div class="mt-5 grid gap-3">
              {articulos.map((a) => (
                <details class="plegable plegable--tenue">
                  <summary class="resumen min-h-12 items-start py-2.5 font-normal">
                    <span class="min-w-0 flex-1">
                      <span class="font-medium text-texto">{a.referencia}</span>
                      {a.epigrafe ? (
                        <span class="text-texto-2"> · {a.epigrafe}</span>
                      ) : null}
                    </span>
                    <ChevronDown
                      class="resumen__flecha mt-1"
                      aria-hidden="true"
                    />
                  </summary>
                  <CitaLegal norma={n} articulo={a} t={tg} class="mt-2" />
                </details>
              ))}
            </div>
          )}
        </section>

        <section>
          <h2 class="titulo-3">{t('obligaciones')}</h2>
          {reglas.length === 0 ? (
            <p class="mt-3">{t('sinObligaciones')}</p>
          ) : (
            <ul class="mt-5 grid gap-3">
              {reglas.map((r) => {
                const req = requisito(r.requisito);
                if (!req) return null;
                const tm = tema(req.tema);
                return (
                  <li>
                    <a
                      href={ruta(tm ? `/temas/${tm.slug}` : '/consulta')}
                      class="flex flex-wrap items-center gap-3 rounded-2xl border border-borde px-4 py-3.5 transition-colors hover:border-marca-300"
                    >
                      <ChipEstado estado={r.estado} t={tg} />
                      <ChipAmbito ambito={r.ambito} t={tg} />
                      <span class="min-w-0 flex-1 basis-56 font-medium text-texto">
                        {textosRequisito(req).titulo}
                      </span>
                      <ArrowRight
                        class="size-4 text-texto-3"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </section>

        <section>
          <h2 class="titulo-3">{t('historial')}</h2>
          {historial.length === 0 ? (
            <p class="mt-3">{t('sinHistorial')}</p>
          ) : (
            <ul class="mt-5 grid gap-3">
              {historial.map((h) => (
                <li>
                  <p class="font-medium text-texto">{h.titulo}</p>
                  {h.publicadoEn ? (
                    <p class="text-sm text-texto-3">{fecha(h.publicadoEn)}</p>
                  ) : null}
                </li>
              ))}
            </ul>
          )}
        </section>

        <p class="border-t border-borde pt-5 text-sm font-medium text-texto-2">
          {tg('comun.descargo')}
        </p>
      </div>

      <aside class="lg:sticky lg:top-[calc(var(--cabecera)+24px)] lg:self-start">
        <div class="tarjeta gap-5 p-6">
          <h2 class="rotulo">{t('datos')}</h2>
          <dl class="resumen-consulta">
            {datos.map(([etiqueta, valor]) => (
              <div>
                <dt>{etiqueta}</dt>
                <dd class="cifras">{valor}</dd>
              </div>
            ))}
          </dl>
          {c ? (
            <a
              href={ruta(`/comunidades/${c.slug}`)}
              class="enlace-flecha text-[0.9375rem]"
            >
              {t('enComunidad', { comunidad: c.nombre })}
              <ArrowRight aria-hidden="true" />
            </a>
          ) : null}
        </div>
      </aside>
    </div>
  </div>
</Base>
