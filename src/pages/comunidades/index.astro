---
import { ArrowRight } from 'lucide-preact';
import CabeceraPagina from '@/componentes/pagina/CabeceraPagina.astro';
import PanelCta from '@/componentes/pagina/PanelCta.astro';
import { traductor } from '@/i18n/catalogos';
import { ruta } from '@/lib/rutas';
import Base from '@/layouts/Base.astro';
import { comunidades, situacionComunidad } from '@/lib/datos';
import { obligacionesDeReferencia } from '@/lib/datos/evaluacion';
import { nombreNorma } from '@/lib/datos/textos';
import { ChipEstado } from '@/ui/Chips';

const tg = traductor();
const t = tg.en('comunidades');
const ti = tg.en('inicio.comunidades');

const COLUMNAS = [
  'identificacion_animales',
  'censo_municipal',
  'seguro_rc_perros',
] as const;
const columnas = [t('colIdentificacion'), t('colCenso'), t('colSeguro')];
const filas = comunidades().map((c) => {
  const s = situacionComunidad(c.codigoIne);
  const obligaciones = obligacionesDeReferencia(
    { comunidad: c.codigoIne },
    'perro',
  );
  return {
    c,
    s,
    situacion: s.tipo === 'reglas' ? ti('reglas', { n: s.reglas }) : ti(s.tipo),
    estados: COLUMNAS.map(
      (clave) =>
        obligaciones.find((o) => o.requisito.clave === clave)?.resultado
          .estado ?? 'no_aplica',
    ),
  };
});
---

<Base
  ruta="/comunidades"
  titulo={t('metaTitulo')}
  descripcion={t('metaDescripcion')}
>
  <CabeceraPagina titulo={t('titulo')} entradilla={t('entradilla')} solape>
    <a href={ruta('/mapa')} class="boton boton--contorno">
      {t('mapa')}
      <ArrowRight aria-hidden="true" />
    </a>
  </CabeceraPagina>

  <div class="contenedor solape pb-[var(--seccion)]">
    <div class="rounded-[28px] border border-borde bg-superficie p-3 shadow-alta sm:p-6">
      <table class="tabla max-lg:apilada">
        <caption class="px-4 pt-2 pb-4 text-left font-display text-lg font-semibold text-texto">
          {t('comparativa')}
        </caption>
        <thead>
          <tr>
            <th scope="col">{t('colComunidad')}</th>
            <th scope="col">{t('colLey')}</th>
            {columnas.map((c) => (
              <th scope="col">{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {filas.map(({ c, s, situacion, estados }) => (
            <tr>
              <td>
                <a
                  href={ruta(`/comunidades/${c.slug}`)}
                  class="inline-block py-0.5 font-semibold text-texto underline-offset-2 hover:underline"
                >
                  {c.nombre}
                </a>
              </td>
              <td data-etiqueta={t('colLey')}>
                {s.normas[0] ? (
                  <a
                    href={ruta(`/normativa/${s.normas[0].slug}`)}
                    class="text-[0.9375rem] text-marca-700 underline underline-offset-2"
                  >
                    {nombreNorma(s.normas[0])}
                  </a>
                ) : null}
                <span class="mt-1 block text-sm text-texto-3">{situacion}</span>
              </td>
              {estados.map((estado, i) => (
                <td data-etiqueta={columnas[i]}>
                  <ChipEstado estado={estado} t={tg} />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <PanelCta
    titulo={tg('inicio.cta.titulo')}
    texto={tg('inicio.cta.texto')}
    boton={tg('inicio.cta.boton')}
  />
</Base>
