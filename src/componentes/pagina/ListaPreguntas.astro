---
/**
 * Preguntas frecuentes con apertura animada (.faq). Con `conFuentes`, cada
 * respuesta cita los articulos que la respaldan.
 */
import { traductor } from '@/i18n/catalogos';
import { PREGUNTAS, type ClavePregunta } from '@/lib/contenido/preguntas';
import { articulo, norma } from '@/lib/datos';
import { CitaLegal } from '@/ui/CitaLegal';

interface Props {
  claves?: readonly ClavePregunta[];
  conFuentes?: boolean;
  abiertaPrimera?: boolean;
}

const { claves, conFuentes = false, abiertaPrimera = false } = Astro.props;
const t = traductor();
const tf = t.en('faq.preguntas');
const lista = claves
  ? PREGUNTAS.filter((p) => claves.includes(p.clave))
  : PREGUNTAS;
const fuentesDe = (ids: readonly string[]) =>
  ids.flatMap((id) => {
    const a = articulo(id);
    const n = a ? norma(a.norma) : undefined;
    return a && n ? [{ a, n }] : [];
  });
---

<div class="faq" data-escalonado="fundido">
  {lista.map((pregunta, i) => (
    <details id={pregunta.clave} open={abiertaPrimera && i === 0}>
      <summary>
        {tf(`${pregunta.clave}.p`)}
        <span class="faq__icono" aria-hidden="true" />
      </summary>
      <div class="grid max-w-[70ch] gap-4 pb-7">
        <p>{tf(`${pregunta.clave}.r`)}</p>
        {conFuentes &&
          fuentesDe(pregunta.articulos).map(({ a, n }) => (
            <CitaLegal norma={n} articulo={a} t={t} />
          ))}
      </div>
    </details>
  ))}
</div>
