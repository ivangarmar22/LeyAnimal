---
/**
 * Rejilla de situaciones y accesos a otras guias. La portada solo pinta las
 * de `claves`.
 */
import { ArrowRight } from 'lucide-preact';
import { traductor } from '@/i18n/catalogos';
import { ruta } from '@/lib/rutas';
import { ICONOS_SITUACION } from '@/lib/contenido/iconos';
import { ACCESOS, SITUACIONES } from '@/lib/contenido/situaciones';
import { Ilustracion } from '@/ui/Ilustracion';

interface Props {
  /** Solo estas, en este orden. Sin lista, todas. */
  claves?: readonly string[];
}

const t = traductor('situaciones');
const todas = [
  ...SITUACIONES.map(({ slug }) => ({
    clave: slug,
    href: `/situaciones/${slug}`,
    titulo: t(`guias.${slug}.titulo`),
    texto: t(`guias.${slug}.resumen`),
  })),
  ...ACCESOS.map(({ clave, href }) => ({
    clave,
    href,
    titulo: t(`accesos.${clave}.titulo`),
    texto: t(`accesos.${clave}.texto`),
  })),
];
const { claves } = Astro.props;
const tarjetas = claves
  ? claves.map((clave) => {
      const tarjeta = todas.find((x) => x.clave === clave);
      if (!tarjeta) throw new Error(`Situacion desconocida: ${clave}`);
      return tarjeta;
    })
  : todas;
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-escalonado>
  {tarjetas.map(({ clave, href, titulo, texto }) => {
    const Icono = ICONOS_SITUACION[clave];
    return (
      <li>
        <a href={ruta(href)} class="tarjeta foco-luz h-full gap-4">
          <span class="esquinas" aria-hidden="true">
            <i />
            <i />
            <i />
            <i />
          </span>
          <span class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-5">
            {Icono ? (
              <span class="caja-icono shrink-0">
                <Ilustracion icono={Icono} />
              </span>
            ) : null}
            <span class="titulo-3 font-display font-semibold text-texto">
              {titulo}
            </span>
          </span>
          <span>{texto}</span>
          <span class="enlace-flecha mt-auto text-[0.9375rem]">
            {t('leer')}
            <ArrowRight aria-hidden="true" />
          </span>
        </a>
      </li>
    );
  })}
</ul>
